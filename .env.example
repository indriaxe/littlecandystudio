APP_NAME="Little Candy Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---- Database (MySQL dari XAMPP / phpMyAdmin) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=littlecandy
DB_USERNAME=root
DB_PASSWORD=

# Session & cache disimpan di file, jadi tidak butuh tabel tambahan
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---- Akun admin (dibuat oleh `php artisan migrate --seed`) ----
# GANTI password ini sebelum website dipublikasikan!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
